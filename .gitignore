# ---- Never commit the game or anything derived from its assets ----
# ROM images (any extension/region)
*.sfc
*.smc
*.fig
*.swc
rom/*
!rom/README.md

# Raw dumps, memory snapshots, VRAM, save states
*.dmp
*.bin
*.srm
*.sav
*.state
vram*.dmp

# Extracted audio (copyrighted) — SPC/sequence/sample artifacts
*.spc
*.mid
*.midi
*.sf2
*.dls
*.wav
*.brr

# Screenshots / captured game graphics (copyrighted pixels)
*.png
*.jpg
*.jpeg
*.gif
*.bmp

# Generated artifacts (the .tbl is regenerable from the tool)
docs/rudra-jap.tbl

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
